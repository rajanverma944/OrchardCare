# Copy to .env and adjust. .env is git-ignored - never commit real secrets.
DATABASE_URL=postgresql://orchard:orchard_local_dev@127.0.0.1:5432/orchardcare
DATABASE_URL_TEST=postgresql://orchard:orchard_local_dev@127.0.0.1:5432/orchardcare_test
# 64+ random hex chars - generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
PORT=5092
PHOTOS_DIR=data/photos
# LAN IP of this PC - the mobile app (BlueStacks/device) connects to this
PUBLIC_BASE_URL=http://192.168.1.7:5092
ACCESS_TOKEN_HOURS=24
REFRESH_TOKEN_DAYS=90
